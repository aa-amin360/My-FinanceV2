# Copy to .env.local and fill in the values.

# PostgreSQL connection string (e.g. Neon pooled connection string with ?sslmode=require)
DATABASE_URL=

# Base URL of the app and a random secret for signing sessions
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Optional: Google sign-in (redirect URI: <NEXTAUTH_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: currency label and number formatting locale shown in the UI
NEXT_PUBLIC_CURRENCY=Tk
NEXT_PUBLIC_NUMBER_LOCALE=en-BD
